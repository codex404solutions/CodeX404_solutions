RewriteEngine On

# 1. Redirect /page.php to /page (External Redirect)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.php\ HTTP/ [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L]

# 2. Map /page back to /page.php internally (Internal Mapping)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^/]+)$ $1.php [L]