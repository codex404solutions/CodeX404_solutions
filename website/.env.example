# ==============================================================================
# CodeX404 Solutions — Environment Variables Template
# Copy to .env and configure for local, development, or production environments
# ==============================================================================

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (Optional - File-backed fallback is active if offline)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=codex404_db
DB_USER=root
DB_PASS=

# Mail Configuration (Optional - Notifications logged to storage/logs/app.log)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=info@codex404solutions.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# Admin Portal Authentication (Required for website/admin access)
# Generate a strong password hash using: php -r "echo password_hash('YourStrongPassword', PASSWORD_DEFAULT);"
ADMIN_USER=admin
ADMIN_ALT_USER=founder
ADMIN_PASS_HASH=

# Future CRM Webhook Pipeline (Optional - Integration point for CRM lead ingestion)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=codex404_crm_secret

