# ==============================================================================
# CodeX404 Solutions — CRM Apache Configuration
# Separate application: private dashboard + signed lead API.
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Block sensitive paths -------------------------------------------------
    # Directories that must never be served over HTTP.
    RewriteRule ^(app|config|storage|database|views|vendor)(/|$) - [F,L]
    # Hidden files (.env, .htaccess, .git).
    RewriteRule (^|/)\. - [F,L]
    # SQL dumps and backups.
    RewriteRule \.(sql|bak|log|ini|sh|md)$ - [F,L]

    # --- Allow direct access to api/ (with extensionless rewriting) ---
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^api/(.*)$ api/$1.php [L]
    RewriteRule ^api(/|$) - [L]

    # --- Redirects from .php / public to clean URLs (GET/HEAD requests only) ---
    # 1. Redirect /index.php or /public/index(.php) to directory root
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^?]*?)(?:/public/index(?:\.php)?|/index\.php)([^\s?]*) [NC]
    RewriteRule ^.*$ %1/%2 [R=301,L,NE]

    # 2. Redirect /login.php or /public/login(.php) to /login
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^?]*?)(?:/public/login(?:\.php)?|/login\.php)([^\s?]*) [NC]
    RewriteRule ^.*$ %1/login%2 [R=301,L,NE]

    # 3. Redirect /logout.php or /public/logout(.php) to /logout
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^?]*?)(?:/public/logout(?:\.php)?|/logout\.php)([^\s?]*) [NC]
    RewriteRule ^.*$ %1/logout%2 [R=301,L,NE]

    # 4. Redirect other *.php to extensionless
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^?]+)\.php([^\s?]*) [NC]
    RewriteRule ^(.+)\.php$ %1%2 [R=301,L,NE]

    # --- Public routing --------------------------------------------------------
    # Root -> dashboard
    RewriteRule ^$ public/index.php [L]

    # Clean aliases for the auth endpoints
    RewriteRule ^login/?$ public/login.php [L]
    RewriteRule ^logout/?$ public/logout.php [L]

    # Clean multi-page routes
    RewriteRule ^dashboard/?$ public/index.php [L]
    RewriteRule ^leads/?$ public/leads.php [L]
    RewriteRule ^pipeline/?$ public/pipeline.php [L]
    RewriteRule ^projects/?$ public/projects.php [L]
    RewriteRule ^paperclip/?$ public/paperclip.php [L]
    RewriteRule ^agents/?$ public/paperclip.php [L]
    RewriteRule ^approvals/?$ public/approvals.php [L]
    RewriteRule ^users/?$ public/users.php [L]
    RewriteRule ^profile/?$ public/profile.php [L]
    RewriteRule ^settings/?$ public/settings.php [L]

    # Clean URLs fallback: /name -> public/name.php (when the target file exists)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/codes/CodeX404_solutions/crm/public/$1.php -f
    RewriteRule ^(.*)$ public/$1.php [L]

    # Direct access to public assets (css, js, assets, logo)
    RewriteRule ^(css|js|assets|logo)/(.*)$ public/$1/$2 [L,QSA]

    # Direct files in public/ (e.g. assets, static files)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/codes/CodeX404_solutions/crm/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# Never execute or expose anything under storage
<IfModule mod_rewrite.c>
    RewriteRule ^storage/ - [F,L]
</IfModule>

# Disable directory browsing
Options -Indexes
