# ==============================================================================
# CodeX404 CRM — Environment Configuration
# Copy to .env and configure. Never commit real secrets to version control.
# ==============================================================================

# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/crm

# Website Integration (required for lead ingestion)
CRM_WEBHOOK_URL=https://crm.codex404solutions.online/api/v1/leads.php
CRM_WEBHOOK_SECRET=generate_a_long_random_string_using_openssl_rand_hex_32_or_similar
# IP allowlisting for inbound webhooks (comma-separated IPs; leave blank to allow all validly signed requests)
CRM_WEBHOOK_ALLOWED_IPS=


# Admin authentication (generate with password_hash())
CRM_ADMIN_EMAIL=admin@codex404solutions.online
CRM_ADMIN_PASSWORD_HASH=paste_password_hash_here
CRM_ADMIN_NAME=CodeX404 Founder


# Database (configure when ready to switch from JSON to MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=codex404_crm
DB_USER=root
DB_PASS=

# Email (SMTP for future outbound)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=crm@codex404solutions.online
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls